// OAMS Platform — PostgreSQL schema (source of truth for the whole system).
// Run `npx prisma migrate dev` after editing to generate migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  SELLER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

// The "full SaaS click system" event types.
enum EventType {
  PAGE_VIEW
  PRODUCT_VIEW
  PRODUCT_CLICK
  LISTING_VIEW
  LISTING_CLICK
  EXPAND
  ADD_TO_CART
  CHECKOUT
  PURCHASE
  SEARCH
}

// Customer support ticket lifecycle.
enum SupportStatus {
  NEW
  OPEN
  WAITING
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  bio          String?
  avatarUrl    String?
  storeName    String?
  storeCategory String?
  // none | requested | active | suspended
  sellerStatus String   @default("none")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products   Product[]
  orders     Order[]
  events     AnalyticsEvent[]
  sessions   Session[]
  orderItems OrderItem[]
  supportTickets  SupportTicket[]
  supportMessages SupportMessage[]
}

// One table powers BOTH the official store catalog (sellerId = null)
// and marketplace seller listings (sellerId set, marketplaceEnabled = true).
model Product {
  id          String   @id @default(cuid())
  slug        String
  name        String
  description String
  category    String
  // Money stored in minor units (e.g. cents). Within OAMS prices are integer DH.
  price           Int
  originalPrice   Int?
  currency        String   @default("MAD")
  brand           String?
  sizes           String[]
  colors          String[]
  // JSON map: color -> quantity, e.g. { "Black": 30 }
  stock            Json
  isNew            Boolean  @default(false)
  isSale           Boolean  @default(false)
  isActive         Boolean  @default(true)
  marketplaceEnabled Boolean @default(false)
  rating           Float    @default(0)
  reviewsCount     Int      @default(0)

  sellerId String?
  seller   User?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images     ProductImage[]
  orderItems OrderItem[]
  events     AnalyticsEvent[]

  @@unique([sellerId, slug])
  @@index([category])
  @@index([marketplaceEnabled])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url    String // primary / smallest sensible
  master String?
  large  String?
  medium String?
  thumb  String?
  tiny   String?

  // Which variant (size / color / price) this image shows. One size can have
  // multiple images, and each image can show a different size/color/price.
  size  String?
  color String?
  price Int    @default(0)

  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

// Image-only displays shown to users (e.g. a popup on site open).
// Each is a photo plus a target route for where it navigates when clicked.
model Banner {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  route     String   @default("/")
  isPopup   Boolean  @default(true)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Single-image slides shown in the homepage hero slide gallery. Admins can
// upload (add) new slides and remove existing ones from the admin panel.
model HeroSlide {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  route     String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique
  userId      String?
  user        User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  status OrderStatus @default(PENDING)

  // Snapshot of the customer at order time (name, email, phone, address, notes)
  customer     Json
  subtotal     Int
  shippingCost Int    @default(0)
  total        Int
  currency     String @default("MAD")

  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  notes       String?

  // Courier / carrier reference given to the customer (set by admin, or by a
  // seller when they ship their own line). Emailed to the buyer once shipped.
  trackingNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([status])
  @@index([userId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Every item carries its seller so sellers only see their own sales.
  sellerId String?
  seller   User? @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  skuSnapshot Json // name/sku snapshot at purchase time
  name    String
  price   Int
  quantity Int
  size    String?
  color   String?
  total   Int

  // Per-line fulfillment so each seller can update the status of their own
  // sales independently (admin still controls the whole order).
  status OrderStatus @default(PENDING)
  trackingNumber String?

  @@index([orderId])
  @@index([sellerId])
  @@index([status])
}

// The SaaS analytics engine — append-only event stream.
model AnalyticsEvent {
  id        String    @id @default(cuid())
  type      EventType
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId String?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  sessionId String?
  page      String?
  referrer  String?
  userAgent String?
  device    String?
  ip        String?
  meta      Json?

  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([productId, type])
  @@index([userId])
  @@index([sessionId])
}

// Optional JWT revocation / session tracking.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Customer support / help-desk ticket. Anyone can open one from the /support
// page; admins manage the queue and reply from the admin panel.
model SupportTicket {
  id           String          @id @default(cuid())
  ticketNumber String          @unique
  subject      String
  // Original request body (first contact with the customer).
  message      String
  status       SupportStatus   @default(NEW)
  priority     SupportPriority @default(MEDIUM)

  name  String
  email String
  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  messages  SupportMessage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status])
  @@index([email])
  @@index([userId])
}

// One conversation entry inside a support ticket (customer or staff).
model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId   String?
  author     User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  isStaff    Boolean       @default(false)
  body       String
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}