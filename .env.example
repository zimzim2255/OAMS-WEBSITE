# ===== OAMS Platform — environment template =====
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://oams:oams@localhost:5432/oams?schema=public"
# Prisma needs a direct URL for migrations (avoids pools/proxies)
DIRECT_URL="postgresql://oams:oams@localhost:5432/oams?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-secret"
SESSION_COOKIE="oams_session"
# 7 days in seconds
SESSION_TTL=604800

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Local disk storage for optimized uploads (VPS volume)
UPLOAD_DIR="./public/uploads"

# --- Image pipeline (CDN) — OPTIONAL. Leave blank to use local sharp pipeline ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Email (SMTP for order/seller notifications) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="OAMS <no-reply@oams.shop>"

# --- Admin bootstrap (seeded on first run) ---
ADMIN_EMAIL="admin@oams.shop"
ADMIN_PASSWORD="change-me-now"

# --- Optional: Stripe (Phase 2 payments) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""